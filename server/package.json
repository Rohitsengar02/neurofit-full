{
  "name": "neurofit-api",
  "version": "2.0.0",
  "private": true,
  "description": "NeuroFit API: one backend for the user app and the admin panel (Postgres, R2, LiveKit)",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "seed:exercises": "node src/seed/exercises.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.20.1",
    "lru-cache": "^11.5.3",
    "pg": "^8.23.1"
  }
}
